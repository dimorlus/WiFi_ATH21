{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "ESP8266: Build All",
            "type": "shell",
            "command": "mingw32-make.exe",
            "args": [
                "-f", 
                "${workspaceFolder}/Makefile", 
                "all"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": true,
                "clear": false
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "ESP8266: Clean",
            "type": "shell",

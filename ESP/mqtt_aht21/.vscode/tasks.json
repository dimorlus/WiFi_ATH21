        {
            "label": "Serial Monitor (PuTTY)",
            "type": "shell",
            "command": "putty.exe",
            "args": [
                "-serial",
                "COM3",
                "-sercfg",
                "115200,8,n,1,N"
            ],
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "isBackground": true
        },
        {
            "label": "Serial Monitor (PowerShell)",
            "type": "shell",
            "command": "[System.IO.Ports.SerialPort]::getportnames() | Write-Host; $port = new-Object System.IO.Ports.SerialPort COM3,115200,None,8,one; $port.Open(); while($true) { if($port.BytesToRead -gt 0) { Write-Host $port.ReadLine() } Start-Sleep -m 10 }",
            "group": "test",
            "presentation": {
                "echo": false,
                "reveal": "always",
                "focus": true,
                "panel": "new"
            },
            "isBackground": true
        },
        {
            "label": "Check COM Ports",
            "type": "shell", 
            "command": "Get-WmiObject -Class Win32_SerialPort | Select-Object Name,DeviceID,Description",
            "group": "test",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared"
            }
        },
